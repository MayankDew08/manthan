# Copy to .env and fill in the LLM and Neo4j settings before first use.

# ---- LLM: local llama.cpp server (OpenAI-compatible) ----
LLAMA_BASE_URL=http://localhost:8080
LLAMA_MODEL=
# Read timeout per LLM request in seconds (local models can be slow).
LLAMA_REQUEST_TIMEOUT=600
# Optional global toggle for structured extraction calls (off by default).
LLAMA_DISABLE_THINKING=0

# Pass 2 is intentionally one contextual target per call for small local models.
GRADER_DISABLE_THINKING=1
GRADER_PASS2_MAX_BATCH=1
GRADER_PASS2_COMPLETION_TOKENS=4096
GRADER_PASS2_TARGET_CHARS=1200
GRADER_PASS2_CONTEXT_CHARS=500

# ---- Checkpointing / resume ----
# SQLite checkpointer db used by langgraph to resume a crashed run at the last
# completed stage. Per-batch grading progress goes to GRADING_CHECKPOINT.
MANTHAN_CHECKPOINT_DB=state.sqlite
GRADING_CHECKPOINT=grading_checkpoint.json

# ---- GitHub API ----
# Optional. Leave empty to use the unauthenticated GitHub API (60 req/hour).
# Set to boost the limit (5000 req/hour). Create at https://github.com/settings/tokens
# (public-repo read scope is enough).
GITHUB_TOKEN=

# ---- YouTube transcript fallback ----
# Optional. Supadata is used only if youtube-transcript-api fails on a video.
# Free tier ~100 requests/month. Get a key at https://supadata.ai
SUPADATA_API_KEY=

# ---- Graph / vector stores ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=manthan

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
REDIS_ADDR=localhost:6379
MANTHAN_API_URL=http://localhost:8000

# ---- App ----
STATE_FILE=state.json
DISCARDED_LOG=discarded_log.json
